# Server-only Cloudflare Pages secret. Never prefix this with PUBLIC_.
RESEND_API_KEY=
# Use a verified Resend sender after DNS verification:
ENQUIRY_FROM=Primelink Website <website@primelinkaustralia.com.au>
# Optional quote destination. Default is the confirmed working info mailbox.
RFQ_TO=info@primelinkaustralia.com.au
# Forms default to /api/enquiry; normally leave this unset.
PUBLIC_FORM_ENDPOINT=
