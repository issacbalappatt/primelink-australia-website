---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { industries } from '../../data/industries';
import { getCategory } from '../../data/products';
---

<Base title="Industries" description="HVAC spare parts for offshore platforms, FPSOs, LNG and gas processing, refineries, mining and power generation.">
  <PageHero
    title="Industries we supply"
    lead="Oil and gas facilities depend on HVAC to protect people, keep gas out of safe areas and cool critical equipment. We understand the conditions on each type of site."
    crumbs={[{ label: 'Industries' }]}
  />

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line md:grid-cols-2">
      {
        industries.map((i) => (
          <a href={`/industries/${i.slug}/`} class="group flex flex-col bg-white p-8 hover:bg-fog-2 md:p-10">
            <h2 class="t-h2 text-ink">{i.name}</h2>
            <p class="mt-3 max-w-md text-steel">{i.short}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {i.supply.slice(0, 4).map((s) => (
                <li class="rounded-full bg-fog px-3 py-1 text-[0.8rem] font-[560] text-ink group-hover:bg-white">{getCategory(s)?.name.replace(' and compressor parts', '')}</li>
              ))}
            </ul>
            <span class="mt-auto flex items-center gap-1.5 pt-8 text-[0.95rem] font-[600] text-ink">
              See how we support {i.name.toLowerCase()}
              <Icon name="tabler:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>
