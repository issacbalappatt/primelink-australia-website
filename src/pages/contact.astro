---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../config/site';

const channels = [
  { title: 'Sales and quotes', text: 'Part enquiries, quotes and orders.', email: site.contact.salesEmail },
  { title: 'General enquiries', text: 'Accounts, suppliers and everything else.', email: site.contact.generalEmail },
];
---

<Base title="Contact" description="Contact Primelink Australia about HVAC and refrigeration spare parts: quotes, orders, logistics and general enquiries.">
  <PageHero title="Contact us" lead="Talk to a person who understands HVAC parts. For part enquiries, the quote form is the fastest route." crumbs={[{ label: 'Contact' }]} />

  <section class="py-12 md:py-16">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="grid content-start gap-8 lg:col-span-5">
        {
          channels.map((c) => (
            <div class="border-t-2 border-ink pt-5">
              <h2 class="t-h3 text-ink">{c.title}</h2>
              <p class="mt-1 text-steel">{c.text}</p>
              <a href={`mailto:${c.email}`} class="link mt-3 inline-block break-all">
                {c.email}
              </a>
            </div>
          ))
        }
        <div class="border-t-2 border-ink pt-5">
          <h2 class="t-h3 text-ink">Office</h2>
          <address class="mt-2 not-italic text-steel">
            {site.contact.addressLines.map((l) => <span class="block">{l}</span>)}
          </address>
          {site.contact.phone && <p class="mt-2 text-ink"><a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="hover:underline">{site.contact.phone}</a></p>}
          <p class="t-small mt-3 text-steel">{site.contact.hours}</p>
          {
            site.contact.whatsapp && (
              <a href={`https://wa.me/${site.contact.whatsapp}`} class="btn btn-outline mt-5" rel="noopener">
                <Icon name="tabler:brand-whatsapp" class="size-5" aria-hidden="true" />
                Message on WhatsApp
              </a>
            )
          }
        </div>
        <div class="rounded-[var(--radius-card)] bg-fog p-6">
          <p class="font-[600] text-ink">Have part numbers ready?</p>
          <p class="t-small mt-1 text-steel">Use the quote form. It lets you add several lines and attach photos.</p>
          <a href="/request-a-quote/" class="btn btn-primary mt-4">Request a quote</a>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <form action="/api/enquiry" method="post" enctype="multipart/form-data" id="contact-form" class="grid gap-5 rounded-[var(--radius-card)] border border-line p-6 md:p-8" data-endpoint={site.formEndpoint || undefined} data-success="contact-success" data-to={site.contact.generalEmail}>
          <h2 class="t-h3 text-ink">Send a message</h2>
          <noscript><p>Please enable JavaScript to submit this form, or email us using the address on this page.</p></noscript>
          <input type="hidden" name="form" value="Contact" />
          <div class="hidden" aria-hidden="true"><label>Leave empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="field"><span>Full name</span><input name="name" class="input" required autocomplete="name" data-label="Name" /></label>
            <label class="field"><span>Company</span><input name="company" class="input" autocomplete="organization" data-label="Company" /></label>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="field"><span>Email</span><input name="email" type="email" class="input" required autocomplete="email" data-label="Email" /></label>
            <label class="field"><span>Country</span><input name="country" class="input" autocomplete="country-name" data-label="Country" /></label>
          </div>
          <label class="field">
            <span>Topic</span>
            <select name="topic" class="input" data-label="Topic">
              <option>Part enquiry</option>
              <option>Existing order</option>
              <option>Spares programme or shutdown</option>
              <option>Supplier enquiry</option>
              <option>Other</option>
            </select>
          </label>
          <label class="field"><span>Message</span><textarea name="message" rows="6" class="input" required data-label="Message"></textarea></label>
          <div>
            <button type="submit" class="btn btn-primary"><Icon name="tabler:send" class="size-5" aria-hidden="true" />Send message</button>
            <p class="t-small mt-3 text-steel">We use your details only to reply. See our <a href="/privacy/" class="link font-[500]">privacy policy</a>.</p>
            <p data-form-status role="status" class="t-small mt-3"></p>
          </div>
        </form>
        <div id="contact-success" class="hidden rounded-[var(--radius-card)] border border-line bg-fog-2 p-10" tabindex="-1">
          <Icon name="tabler:circle-check" class="size-10 text-ink" aria-hidden="true" />
          <h2 class="t-h2 mt-5 text-ink">Message sent</h2>
          <p class="mt-3 text-steel">Thank you. We will reply by email as soon as we can, usually within {site.quoteResponse}.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initForm } from '../scripts/forms';
  const form = document.getElementById('contact-form') as HTMLFormElement;
  initForm(form, {
    to: form.dataset.to || '',
    subject: (fd) => `Website enquiry: ${fd.get('topic') || 'General'}`,
  });
</script>
