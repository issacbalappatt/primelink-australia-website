---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { categories } from '../data/products';
import { industries } from '../data/industries';
import { destinations } from '../data/regions';

const facts = [
  { value: String(categories.length), label: 'HVAC product families' },
  { value: String(industries.length), label: 'Industries supplied' },
  { value: String(destinations.length), label: 'Oil and gas regions on our routes' },
  { value: '1', label: 'Contact person for each request' },
];

const principles = [
  { title: 'Say what we know', text: 'We tell you the source, the real lead time and any difference from the original part, before you order.' },
  { title: 'Treat safety parts as safety parts', text: 'A damper or an Ex motor protects people. We check it with that in mind.' },
  { title: 'Make the buyer’s job easier', text: 'One quote, one contact and one document pack, however many makers are on the list.' },
  { title: 'Keep the promise', text: `If we say we will reply within ${site.quoteResponse}, we reply within ${site.quoteResponse}.` },
];
---

<Base title="About us" description="Primelink Australia is an independent supplier of HVAC spare parts to oil and gas operators worldwide.">
  <PageHero
    title="An Australian supplier for the world’s oil and gas sites"
    lead="Primelink Australia sources, checks and delivers HVAC spare parts for facilities where HVAC is critical to safety and production."
    crumbs={[{ label: 'About us' }]}
  />

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="prose-pl lg:col-span-7">
        <p class="text-[1.3rem] leading-relaxed text-ink" style="font-stretch:102%">
          Oil and gas operators run HVAC systems from many makers, installed over many decades, in some of the hardest environments on earth. When one part fails, the maintenance team needs the right replacement, with the right documents, at a remote site, quickly.
        </p>
        <p>
          We started Primelink Australia to make that simpler. We work as one point of contact for HVAC spare parts across every major make: compressors, coils, fans and motors, controls, refrigeration components, dampers, filters and electrical parts.
        </p>
        <p>
          Our team combines HVAC engineering knowledge with procurement and export experience. We read nameplates and datasheets, understand hazardous-area requirements, and know what an offshore supply base needs to receive a shipment.
        </p>
        <p>
          From Australia, we are close to the producing basins of Southeast Asia, Papua New Guinea and the Middle East, and we ship to oil and gas regions worldwide.
        </p>
      </div>
      <aside class="lg:col-span-4 lg:col-start-9">
        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line">
          {
            facts.map((f) => (
              <div class="flex flex-col bg-white p-6">
                <dt class="t-small order-2 mt-1 text-steel">{f.label}</dt>
                <dd class="tnum order-1 text-[2.5rem] leading-none font-[600] text-ink" style="font-stretch:116%">
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </section>

  <section class="border-y border-line bg-fog py-16 md:py-24">
    <div class="wrap">
      <h2 class="t-h2 max-w-2xl text-ink">How we work</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p) => (
            <div class="border-t-2 border-ink pt-6">
              <h3 class="t-h3 text-ink">{p.title}</h3>
              <p class="mt-3 text-steel">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-6 md:grid-cols-3">
      <a href="/global-reach/" class="group rounded-[var(--radius-card)] border border-line p-7 hover:border-ink">
        <Icon name="tabler:world" class="size-7 text-ink" stroke-width="1.5" aria-hidden="true" />
        <h2 class="t-h3 mt-5 text-ink">Global reach</h2>
        <p class="mt-2 text-steel">Where we ship and how we get parts to remote sites.</p>
      </a>
      <a href="/quality/" class="group rounded-[var(--radius-card)] border border-line p-7 hover:border-ink">
        <Icon name="tabler:shield-check" class="size-7 text-ink" stroke-width="1.5" aria-hidden="true" />
        <h2 class="t-h3 mt-5 text-ink">Quality and compliance</h2>
        <p class="mt-2 text-steel">Traceability, inspection and hazardous-area checks.</p>
      </a>
      <a href="/careers/" class="group rounded-[var(--radius-card)] border border-line p-7 hover:border-ink">
        <Icon name="tabler:users" class="size-7 text-ink" stroke-width="1.5" aria-hidden="true" />
        <h2 class="t-h3 mt-5 text-ink">Careers</h2>
        <p class="mt-2 text-steel">Join a small team with a global customer base.</p>
      </a>
    </div>
  </section>

  <CtaBand />
</Base>
