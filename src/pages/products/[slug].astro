---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, type ProductCategory } from '../../data/products';
import { industries } from '../../data/industries';
import { site } from '../../config/site';
import { midSentence } from '../../utils/text';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

interface Props {
  category: ProductCategory;
}
const { category: c } = Astro.props;
const usedIn = industries.filter((i) => i.supply.includes(c.slug));
const others = categories.filter((o) => o.slug !== c.slug);
---

<Base title={c.name} description={`${c.short} Safe-area and hazardous-area (ATEX and IECEx) parts, supplied worldwide by Primelink Australia.`} keywords={[c.name, ...c.parts.slice(0, 5).map((p) => p.name)]}>
  <section class="border-b border-line bg-fog-2">
    <div class="wrap pt-10 pb-14 md:pb-20">
      <Breadcrumbs items={[{ label: 'Products', href: '/products/' }, { label: c.name }]} />
      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <h1 class="t-h1 text-ink">{c.name}</h1>
          <p class="t-lead mt-6 max-w-2xl text-steel">{c.intro}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`/request-a-quote/?category=${c.slug}`} class="btn btn-primary">Request a quote</a>
            <a href="#parts" class="btn btn-outline">See typical parts</a>
          </div>
        </div>
        <div class="lg:col-span-4 lg:col-start-9">
          <div class="blueprint relative grid aspect-[4/3] place-items-center rounded-[var(--radius-card)] border border-line">
            <Icon name={c.icon} class="size-28 text-ink" stroke-width="1" aria-hidden="true" />
            <span class="absolute bottom-4 left-4 t-label">{c.parts.length} typical part types</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="parts" class="py-16 md:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h2 class="t-h2 text-ink">Typical parts we supply</h2>
        <p class="mt-3 text-steel">This list shows common items. We source other parts in this family on request.</p>
        <table class="mt-8 w-full text-left">
          <thead class="sr-only md:not-sr-only">
            <tr class="border-b-2 border-ink text-[0.875rem] text-steel">
              <th class="py-3 pr-6 font-[560]">Part</th>
              <th class="py-3 pr-6 font-[560]">Notes</th>
              <th class="py-3 font-[560]"><span class="sr-only">Action</span></th>
            </tr>
          </thead>
          <tbody>
            {
              c.parts.map((p) => (
                <tr class="grid border-b border-line py-4 md:table-row md:py-0">
                  <td class="font-[600] text-ink md:py-4 md:pr-6">{p.name}</td>
                  <td class="text-[0.95rem] text-steel md:py-4 md:pr-6">{p.note}</td>
                  <td class="pt-2 md:py-4 md:text-right">
                    <a href={`/request-a-quote/?part=${encodeURIComponent(p.name)}`} class="inline-flex items-center gap-1 text-[0.9rem] font-[600] whitespace-nowrap text-ink hover:underline">
                      Quote <Icon name="tabler:arrow-right" class="size-4" aria-hidden="true" />
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <aside class="grid content-start gap-6 lg:col-span-4">
        <div class="rounded-[var(--radius-card)] bg-ink p-7 text-white">
          <h2 class="t-h3">What to send us</h2>
          <ul class="mt-5 grid gap-3 text-[0.95rem] text-white/80">
            {
              c.sendUs.map((s) => (
                <li class="flex gap-3">
                  <Icon name="tabler:check" class="mt-0.5 size-5 shrink-0 text-signal" aria-hidden="true" />
                  {s}
                </li>
              ))
            }
          </ul>
          <a href={`/request-a-quote/?category=${c.slug}`} class="btn btn-primary mt-7 w-full justify-center">Start a request</a>
          <p class="t-small mt-3 text-center text-white/55">We aim to reply within {site.quoteResponse}.</p>
        </div>
        <div class="rounded-[var(--radius-card)] border border-line p-7">
          <h2 class="t-h3 text-ink">Standards we work to</h2>
          <ul class="mt-4 grid gap-2 text-[0.95rem] text-graphite">
            {c.standards.map((s) => <li>{s}</li>)}
          </ul>
          <p class="t-small mt-4 text-steel">The standards that apply depend on the part and your specification.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-line bg-fog py-14">
    <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-center">
      <h2 class="t-h3 text-ink lg:col-span-3">Equipment makes</h2>
      <div class="lg:col-span-9">
        <ul class="flex flex-wrap gap-x-7 gap-y-2 text-[1.1rem] font-[620] text-ink/60" style="font-stretch:110%">
          {c.makes.map((m) => <li>{m}</li>)}
          <li class="font-[500] text-steel" style="font-stretch:100%">and others on request</li>
        </ul>
      </div>
    </div>
  </section>

  {
    usedIn.length > 0 && (
      <section class="py-16 md:py-20">
        <div class="wrap">
          <h2 class="t-h2 text-ink">Where these parts are used</h2>
          <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {usedIn.map((i) => (
              <li>
                <a href={`/industries/${i.slug}/`} class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line p-6 hover:border-ink">
                  <span class="t-h3 text-ink">{i.name}</span>
                  <span class="mt-2 text-[0.95rem] text-steel">{i.short}</span>
                  <span class="mt-auto flex items-center gap-1.5 pt-5 text-[0.9rem] font-[600] text-ink">
                    Industry details <Icon name="tabler:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-line py-14">
    <div class="wrap">
      <h2 class="t-label">Other product families</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          others.map((o) => (
            <li>
              <a href={`/products/${o.slug}/`} class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-[0.9rem] font-[560] text-ink hover:border-ink">
                <Icon name={o.icon} class="size-4" aria-hidden="true" />
                {o.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title={`Need ${midSentence(c.name)}?`} />
</Base>
