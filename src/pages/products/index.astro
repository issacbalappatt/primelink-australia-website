---
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories } from '../../data/products';
import { equipment } from '../../data/equipment';

const index = categories.flatMap((c) =>
  c.parts.map((p) => ({ part: p.name, note: p.note, cat: c.name, slug: c.slug })),
);
---

<Base title="HVAC spare parts catalogue" description="HVAC and refrigeration spare parts: compressors, coils, Ex-rated fans and motors, controls, valves, dampers, filters and heaters, for packaged units, chillers, AHUs, cabinet coolers and more." keywords={['HVAC spare parts', 'chiller spare parts', 'packaged HVAC unit spares', 'cabinet cooler spares', 'Ex-rated fan motors']}>
  <PageHero
    title="HVAC spare parts catalogue"
    lead="Eight product families, from the original maker or a qualified alternative. Search by part type, or send us the part number."
    crumbs={[{ label: 'Products' }]}
  >
    <div class="mt-10 max-w-2xl">
      <label for="cat-search" class="t-label">Search part types</label>
      <div class="relative mt-2">
        <Icon name="tabler:search" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-steel" aria-hidden="true" />
        <input id="cat-search" type="search" class="input h-13 pl-12 text-[1.05rem]" placeholder="For example: solenoid valve, blast damper, Ex motor" autocomplete="off" />
      </div>
    </div>
  </PageHero>

  <section id="search-results" class="hidden border-b border-line py-12" aria-live="polite">
    <div class="wrap">
      <p id="search-count" class="t-label"></p>
      <ul id="search-list" class="mt-4 divide-y divide-line border-y border-line"></ul>
      <div id="search-empty" class="hidden rounded-[var(--radius-card)] bg-fog p-8">
        <p class="t-h3 text-ink">No matching part type in the catalogue</p>
        <p class="mt-2 text-steel">The catalogue shows typical items only. Send us the part number or a photo and we will search for it.</p>
        <a id="search-rfq" href="/request-a-quote/" class="btn btn-primary mt-5">Request this part</a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((c) => <CategoryCard category={c} examples={4} />)}
    </div>
  </section>

  <section id="equipment" class="scroll-mt-28 border-t border-line py-16 md:py-24">
    <div class="wrap">
      <div class="max-w-2xl">
        <h2 class="t-h2 text-ink">Equipment we support</h2>
        <p class="t-lead mt-4 text-steel">We supply spare parts for these types of HVAC and refrigeration equipment, for safe areas and Zone 1 and Zone 2 hazardous areas.</p>
      </div>
      <ul class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          equipment.map((e) => (
            <li class="grid grid-cols-[auto_1fr] gap-4">
              <span class="grid size-11 place-items-center rounded-[var(--radius-plate)] bg-fog text-ink">
                <Icon name={e.icon} class="size-5" aria-hidden="true" />
              </span>
              <span>
                <span class="block font-[620] text-ink">{e.name}</span>
                <span class="t-small mt-1 block text-steel">{e.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-fog-2 py-16 md:py-20">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <h2 class="t-h2 text-ink lg:col-span-5">Not in the catalogue? We can still find it.</h2>
      <div class="grid gap-8 sm:grid-cols-3 lg:col-span-7">
        <div>
          <Icon name="tabler:camera" class="size-7 text-ink" stroke-width="1.5" aria-hidden="true" />
          <p class="mt-3 font-[600] text-ink">Send a photo</p>
          <p class="t-small mt-1 text-steel">A clear photo of the nameplate is often enough to identify the part.</p>
        </div>
        <div>
          <Icon name="tabler:arrows-exchange" class="size-7 text-ink" stroke-width="1.5" aria-hidden="true" />
          <p class="mt-3 font-[600] text-ink">Ask for an equivalent</p>
          <p class="t-small mt-1 text-steel">If the part is obsolete, we propose a documented equivalent.</p>
        </div>
        <div>
          <Icon name="tabler:list-details" class="size-7 text-ink" stroke-width="1.5" aria-hidden="true" />
          <p class="mt-3 font-[600] text-ink">Send a full list</p>
          <p class="t-small mt-1 text-steel">Spreadsheets, PDFs and maintenance system exports are all fine.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script is:inline type="application/json" id="part-index" set:html={JSON.stringify(index)} />

<script>
  type Row = { part: string; note: string; cat: string; slug: string };
  const data: Row[] = JSON.parse(document.getElementById('part-index')?.textContent || '[]');
  const input = document.getElementById('cat-search') as HTMLInputElement | null;
  const section = document.getElementById('search-results')!;
  const list = document.getElementById('search-list')!;
  const count = document.getElementById('search-count')!;
  const empty = document.getElementById('search-empty')!;
  const rfq = document.getElementById('search-rfq') as HTMLAnchorElement;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const run = () => {
    const q = (input?.value || '').trim().toLowerCase();
    if (q.length < 2) {
      section.classList.add('hidden');
      return;
    }
    const terms = q.split(/\s+/);
    const hits = data.filter((r) => {
      const hay = `${r.part} ${r.note} ${r.cat}`.toLowerCase();
      return terms.every((t) => hay.includes(t));
    });
    section.classList.remove('hidden');
    count.textContent = hits.length ? `${hits.length} matching part type${hits.length === 1 ? '' : 's'}` : '';
    empty.classList.toggle('hidden', hits.length > 0);
    rfq.href = `/request-a-quote/?part=${encodeURIComponent(input?.value || '')}`;
    list.classList.toggle('hidden', hits.length === 0);
    list.innerHTML = hits
      .map(
        (r) => `<li><a href="/products/${r.slug}/" class="grid gap-1 py-4 hover:bg-fog-2 md:grid-cols-[1.3fr_1fr_1fr] md:items-center md:gap-6 md:px-3">
          <span class="font-[600] text-ink">${esc(r.part)}</span>
          <span class="t-small text-steel">${esc(r.note)}</span>
          <span class="t-small text-ink md:text-right">${esc(r.cat)}</span></a></li>`,
      )
      .join('');
  };
  input?.addEventListener('input', run);
</script>
