---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'insights'>;
}
const { post } = Astro.props;
const date = post.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<a href={`/insights/${post.id}/`} class="group flex h-full flex-col border-t-2 border-ink pt-5">
  <p class="t-label">{post.data.topic}</p>
  <h3 class="mt-3 text-[1.25rem] leading-snug font-[600] text-ink group-hover:underline group-hover:decoration-signal group-hover:decoration-2 group-hover:underline-offset-4" style="font-stretch:106%">
    {post.data.title}
  </h3>
  <p class="t-small mt-3 text-steel">{post.data.description}</p>
  <p class="t-small mt-auto pt-5 text-steel">
    <time datetime={post.data.date.toISOString()}>{date}</time>, {post.data.minutes} min read
  </p>
</a>
