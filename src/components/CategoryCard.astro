---
import { Icon } from 'astro-icon/components';
import type { ProductCategory } from '../data/products';

interface Props {
  category: ProductCategory;
  examples?: number;
}
const { category: c, examples = 3 } = Astro.props;
---

<a href={`/products/${c.slug}/`} class="group flex h-full flex-col overflow-hidden rounded-[var(--radius-card)] border border-line bg-white transition-colors hover:border-ink">
  <div class="blueprint relative flex h-28 items-center sm:h-36 justify-center border-b border-line">
    <Icon name={c.icon} class="size-14 text-ink transition-transform duration-300 group-hover:scale-105" stroke-width="1.25" aria-hidden="true" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-[1.075rem] leading-snug font-[620] text-ink" style="font-stretch:106%">{c.name}</h3>
    <p class="t-small mt-2 text-steel">{c.short}</p>
    <ul class="mt-4 grid gap-1.5 border-t border-line pt-4 text-[0.85rem] text-graphite">
      {c.parts.slice(0, examples).map((p) => <li>{p.name}</li>)}
    </ul>
    <span class="mt-auto flex items-center gap-1.5 pt-5 text-[0.9rem] font-[600] text-ink">
      View parts
      <Icon name="tabler:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    </span>
  </div>
</a>
