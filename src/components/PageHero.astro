---
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  tone?: 'light' | 'dark';
}
const { title, lead, crumbs = [], tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<section class:list={[dark ? 'blueprint-dark text-white' : 'bg-fog-2', 'border-b', dark ? 'border-line-dark' : 'border-line']}>
  <div class="wrap pt-10 pb-14 md:pt-12 md:pb-20">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} tone={tone} />}
    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
      <h1 class:list={['t-h1 lg:col-span-7', dark ? 'text-white' : 'text-ink']}>{title}</h1>
      {lead && <p class:list={['t-lead lg:col-span-5', dark ? 'text-white/75' : 'text-steel']}>{lead}</p>}
    </div>
    <slot />
  </div>
</section>
