---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { withKeywords } from '../config/keywords';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  keywords?: string[];
  ogType?: 'website' | 'article';
}

const { title, description = site.description, ogImage = '/og-image.png', noindex = false, keywords = [], ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonical = new URL(canonicalPath, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,

  url: site.url,
  logo: new URL('/favicon.svg', site.url).href,
  description: site.description,
  email: site.contact.salesEmail,
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
  address: { '@type': 'PostalAddress', addressCountry: 'AU' },
  areaServed: 'Worldwide',
  contactPoint: { '@type': 'ContactPoint', email: site.contact.generalEmail, contactType: 'customer service', availableLanguage: 'English' },
  knowsAbout: ['HVAC spare parts', 'Hazardous area HVAC', 'ATEX and IECEx equipment', 'Refrigeration spare parts', 'Industrial ventilation'],
  ...(site.contact.linkedin ? { sameAs: [site.contact.linkedin] } : {}),
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={withKeywords(keywords)} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0c1e2b" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content="Primelink Australia HVAC and refrigeration spare parts" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'WebSite',
      '@id': `${site.url}/#website`, url: site.url, name: site.name,
      inLanguage: 'en-AU', publisher: { '@id': `${site.url}/#organization` },
    })} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white">
    <a href="#main" class="sr-only z-[70] rounded bg-signal px-4 py-2 font-[600] text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
